# ==============================================================================
# JOG & JOY - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.production or enter these keys in your Vercel / Netlify dashboard.
# ==============================================================================

# 1. Supabase Cloud Database (Required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-webhooks

# 2. Razorpay Live Gateway Credentials (Required for Live Payments)
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_live_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_from_dashboard

# 3. Shipping / Courier Webhook Authentication (Optional but Recommended)
SHIPPING_WEBHOOK_SECRET=your_secure_random_token_for_courier_webhook

# 4. Cloudinary Image Media Storage (Required for Product Image Uploads in Admin)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key
VITE_CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 5. EmailJS Transactional Contact Form (Optional)
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxx

# 6. Google Sheets CRM Webhooks (Optional)
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/xxxx/exec
VITE_DISTRIBUTOR_SCRIPT_URL=https://script.google.com/macros/s/xxxx/exec
